# Configuración de la base de datos
# Formato: dialect+driver://usuario:contraseña@host:puerto/nombre_db
# Para SQLite (desarrollo local):
DATABASE_URL=sqlite:///book_manager.db

# Para PostgreSQL (producción):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/book_manager


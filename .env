# ============================================================
# Base de datos Supabase (PostgreSQL)
# ============================================================
# La aplicación usa el pooler en modo transacción (puerto 6543, IPv4).
# Las migraciones/DDL usan el pooler en modo sesión (puerto 5432).
# Reemplazar [YOUR-PASSWORD] por la contraseña, o dejarlo y definir la
# variable de entorno SUPABASE_DB_PASSWORD (recomendado para no
# versionar la contraseña).

# Aplicación (transaction-mode pooler):
DATABASE_URL="postgresql://postgres.pztgchoerilerhmruzkx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migraciones / creación de tablas (session-mode pooler):
DIRECT_URL="postgresql://postgres.pztgchoerilerhmruzkx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Contraseña de la base (se inyecta en las URL de arriba). Si se completa
# [YOUR-PASSWORD] directamente, esta variable puede quedar vacía.
SUPABASE_DB_PASSWORD=""

# ============================================================
# Fallback local sin Supabase (descomentar para usar SQLite):
# DATABASE_URL=sqlite:///book_manager.db
# ============================================================

# API del dólar (Ejercicio 07)
API_URL=https://dolarapi.com/v1/dolares
DOLAR_API_URL=https://dolarapi.com/v1/dolares
